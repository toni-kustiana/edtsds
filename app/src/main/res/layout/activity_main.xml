<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flRoot"
    android:background="#ffff00"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="RtlSymmetry">
    <id.co.edtslib.edtsds.textfield.date.DateFieldView
        android:id="@+id/dateFieldView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        app:dateIcon="@drawable/ic_alert_cancel"
        app:spinnerSelectedTextAppearance="@style/D1"
        app:spinnerUnselectedTextAppearance="@style/B3"
        app:spinnerBackgroundColor="#F3F5F9"
        app:spinnerBackgroundRadius="16dp"
        app:spinnerBandColor="#ff0000"
        app:spinnerBandRadius="16dp"
        app:calendarType="spinnerWheel"
        app:spinnerButtonText="Pilih"
        app:dateFormat="dd-MM-yyyy"
        app:hint="DD-MM-YYYY"
        app:label="Test"
        app:minAge="17" />
</LinearLayout>